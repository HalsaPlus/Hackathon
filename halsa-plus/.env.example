# Copy this file to .env and fill in the values for local use (npm run dev in halsa-plus/).
# .env is never committed. When Hälsa+ is mounted in the MMD service, set these in
# the root .env or on Render instead.

# Optional. SQLite file. Default: halsa-plus/.data/halsa-plus.sqlite
# On Render: /var/data/halsa-plus.sqlite (on the service's disk).
# HALSA_DATABASE_PATH=

# Optional. Makes sure this token exists for Andrea (only its hash is stored).
# At least 16 characters; make it long and random. Other tokens: npm run token:create.
HALSA_ANDREA_TOKEN=

# Optional. Browser origins allowed to call the API, comma-separated.
# Not needed when the GUI is served by the MMD service (same origin).
HALSA_CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Optional. Default for the demo clock (asOf), ISO 8601. Default: the real current time.
# DEMO_NOW=2026-11-20T15:00:00+01:00

# Optional. Port when run on its own. Default: 3002.
# PORT=
