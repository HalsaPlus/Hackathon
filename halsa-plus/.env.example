# Copy this file to .env and fill in the values for local use.
# .env is never committed.

# Bearer token that every endpoint except /api/v1/health requires.
HALSA_API_TOKEN=

# Browser origins allowed to call the API, comma-separated.
# Example: http://localhost:3001,https://mmd.example.onrender.com
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Optional. Default for the demo clock (asOf), ISO 8601. Default: the real current time.
# DEMO_NOW=2026-11-20T15:00:00+01:00

# Optional. Port for the web server. Default: 3002 (Render sets PORT itself).
# PORT=
